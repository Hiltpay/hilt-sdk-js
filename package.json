{
  "name": "@hiltpay/sdk",
  "version": "1.2.0",
  "description": "Official TypeScript SDK for Hilt Pay Workspace and Hilt Pay API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://docs.hilt.so/developers/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiltpay/hilt-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/Hiltpay/hilt-sdk-js/issues",
    "email": "support@hilt.so"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "default": "./dist/x402.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "hilt",
    "solana",
    "x402",
    "agent",
    "entitlements",
    "payments",
    "checkout",
    "sdk"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
